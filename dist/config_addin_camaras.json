? r.devs.length : -1; }); }\n  function refreshAll() { buildParams(); computeStandard(); recompute(); renderAll(); }\n\n  // ---------- carga ----------\n  function load() {\n    var token = ++loadToken;\n    loading = true; selected = {}; expanded = {}; updateBulk(); $(\"ccf-all\").checked = false;\n    showMsg(\"\", \"\");\n    $(\"ccf-meter\").classList.add(\"on\"); $(\"ccf-bar\").style.width = \"0\";\n    $(\"ccf-headline\").className = \"headline\"; $(\"ccf-headline\").textContent = \"Leyendo la configuración de las cámaras…\";\n    $(\"ccf-body\").innerHTML = '<div class=\"empty\">Cargando cámaras…</div>';\n\n    return getHeaders()\n      .then(function (h) {\n        headers = h;\n        if (!custom) loadSaved();\n        return Promise.all([ms(\"/DeviceMappings\"), apiCall(\"Get\", { typeName: \"Device\", propertySelector: { fields: [\"id\", \"name\", \"licensePlate\", \"serialNumber\"], isIncluded: true } })]);\n      })\n      .then(function (res) {\n        if (!res[0].ok) throw new Error(\"El servicio de cámaras respondió \" + res[0].status + \" al listar las cámaras. Actualizá para reintentar.\");\n        return res[0].json().then(function (maps) { return [maps, res[1] || []]; });\n      })\n      .then(function (r) {\n        if (token !== loadToken) return;\n        var bySerial = {}, other = 0;\n        r[1].forEach(function (d) { if (d.serialNumber) bySerial[d.serialNumber] = d; });\n        rows = (r[0] || []).filter(function (m) { if (m.partnerId === \"surfsight\") return true; other++; return false; })\n          .map(function (m) {\n            var d = bySerial[m.associatedDeviceSerialNumber];\n            return {\n              imei: m.partnerDeviceId, go: m.associatedDeviceSerialNumber || \"\",\n              vehicle: d ? d.name : \"\", plate: d ? (d.licensePlate || \"\") : \"\", deviceId: d ? d.id : null,\n              model: (m.partnerMetaData && m.partnerMetaData.DeviceModel) || \"\",\n              status: m.deviceStatus || \"\", last