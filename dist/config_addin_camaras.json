    var ws = []; for (var k = 0; k < CONCURRENCY; k++) ws.push(worker());\n    return Promise.all(ws);\n  }\n\n  // ---------- aplicar estándar ----------\n  // Solo se corrigen parámetros simples ({\"value\": x} en el primer nivel): es el formato del PATCH que usa MyGeotab.\n  function patchFor(r) {\n    var cfg = {}, skipped = [];\n    r.devs.forEach(function (p) { if (p.simple) cfg[p.path] = { value: JSON.parse(std[p.path]) }; else skipped.push(p); });\n    return { cfg: cfg, n: Object.keys(cfg).length, skipped: skipped };\n  }\n\n  function confirmApply(imeis) {\n    var list = rows.filter(function (r) { return imeis.indexOf(r.imei) >= 0 && r.devs.length; });\n    var fixable = list.filter(function (r) { return patchFor(r).n > 0; });\n    var html;\n    if (!fixable.length) {\n      html = \"<p>Estas diferencias son de privacidad, standby, hotspot o cifrado. Se cambian desde la configuración de la cámara en MyGeotab.</p>\";\n    } else {\n      html = \"<p>Estos valores se van a enviar a \" + (fixable.length === 1 ? \"la cámara\" : \"las \" + fixable.length + \" cámaras\") + \":</p><ul>\";\n      fixable.slice(0, 60).forEach(function (r) {\n        var pf = patchFor(r);\n        html += \"<li><b>\" + esc(r.vehicle || \"Sin vehículo\") + \"</b>\" + (r.plate ? \" · \" + esc(r.plate) : \"\") + \"<br>\" +\n          Object.keys(pf.cfg).map(function (k) { return esc(labelOf(k)) + \": \" + esc(fmt(k, r.cfg[k])) + \" → <b>\" + esc(fmt(k, pf.cfg[k].value)) + \"</b>\"; }).join(\", \") + \"</li>\";\n      });\n      if (fixable.length > 60) html += \"<li>Y \" + (fixable.length - 60) + \" cámaras más</li>\";\n      html += \"</ul>\";\n      var off = fixable.filter(function (r) { return r.status === \"offline\"; }).length;\n      if (off) html += \"<p>\" + (off === 1 ? \"1 cámara está offline y recibe el cambio cuando se conecte.\" : off + \" cámaras están offline y reciben el cambio cuando se conecten.\") + \"</p>\";\n      var partial = fixable.filter(function (r) { retu