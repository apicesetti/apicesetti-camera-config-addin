  "files": {
    "cameraConfig.html": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Configuración de cámaras</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  #ccf {\n    --ink:#1B2A3A; --ink2:#4A5B6C; --ink3:#7C8A98; --line:#E1E6EB; --line2:#CDD5DD;\n    --surface:#F3F5F7; --paper:#FFFFFF; --blue:#2563A8; --bluebg:#EAF1FA;\n    --ok:#2F8F6B; --okbg:#E7F3EE; --dev:#D1423A; --dev1:#E8928C; --devbg:#FBEBEA; --na:#C08A1E; --nabg:#FBF3E2;\n    --idle:#DDE2E8;\n    font-family:\"IBM Plex Sans\", \"Segoe UI\", Roboto, Arial, sans-serif; font-size:14px; line-height:1.45;\n    color:var(--ink); background:var(--surface); min-height:100vh; padding:24px 28px 40px;\n    font-variant-numeric:tabular-nums;\n  }\n  #ccf *, #ccf *::before, #ccf *::after { box-sizing:border-box; }\n  #ccf button, #ccf input, #ccf select { font:inherit; color:inherit; }\n  #ccf :focus-visible { outline:2px solid var(--blue); outline-offset:2px; }\n\n  /* ---------- encabezado ---------- */\n  #ccf .head { display:flex; align-items:flex-end; gap:16px; flex-wrap:wrap; margin-bottom:18px; }\n  #ccf .head-text { flex:1 1 420px; min-width:0; }\n  #ccf .headline { font-size:30px; line-height:1.15; font-weight:600; letter-spacing:-.01em; margin:0; }\n  #ccf .headline.ok { color:var(--ok); }\n  #ccf .headline.dev { color:var(--ink); }\n  #ccf .headline .n { color:var(--dev); }\n  #ccf .lede { margin:6px 0 0; color:var(--ink2); }\n  #ccf .head-actions { display:flex; gap:8px; }\n\n  #ccf .btn { height:34px; padding:0 14px; border-radius:6px; border:1px solid var(--line2); background:var(--paper); cursor:pointer; font-weight:500; white-space:nowrap; }\n  #ccf .btn:hover { border-color:var(--ink3); }\n  #ccf .btn.primary { background:var(--blue); border-color:var(--blue); color:#fff; }\n  #ccf .btn.primary:hover { background:#1E548F; }\n  #ccf .btn:disabled { opacity:.45; cursor:default; }\n  #ccf .btn.sm { height:28px; padding:0 10px; font-size:13px; }\n  #ccf .btn.fix { color:var(--blue); border-color:#BFD3EA; }\n  #ccf .linkbtn { border:none; background:none; color:var(--blue); cursor:pointer; padding:0; font-weight:500; }\n\n  #ccf .msg { padding:10px 14px; border-radius:6px; margin-bottom:16px; display:none; }\n  #ccf .msg.err { display:block; background:var(--devbg); color:#9B2C25; }\n  #ccf .msg.info { display:block; background:var(--bluebg); color:#1B4C82; }\n\n  /* ---------- mosaico de la flota ---------- */\n  #ccf .fleet { background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:16px 18px 14px; margin-bottom:20px; }\n  #ccf .mosaic { display:flex; flex-wrap:wrap; gap:3px; }\n  #ccf .tile { width:13px; height:13px; border-radius:2px; background:var(--idle); border:none; padding:0; cursor:pointer; }\n  #ccf .tile.ok { background:var(--ok); opacity:.32; }\n  #ccf .tile.d1 { background:var(--dev1); }\n  #ccf .tile.d2 { background:var(--dev); }\n  #ccf .tile.na { background:var(--na); }\n  #ccf .tile:hover { outline:2px solid var(--ink); outline-offset:1px; opacity:1; }\n  #ccf .legend { display:flex; gap:18px; flex-wrap:wrap; margin-top:12px; color:var(--ink2); font-size:13px; }\n  #ccf .legend span { display:inline-flex; align-items:center; gap:6px; }\n  #ccf .legend i { width:11px; height:11px; border-radius:2px; display:inline-block; }\n  #ccf .meter { height:3px; background:var(--line); border-radius:2px; overflow:hidden; margin:-6px 0 14px; display:none; }\n  #ccf .meter.on { display:block; }\n  #ccf .meter > div { height:100%; width:0; background:var(--blue); transition:width .25s; }\n\n  /* ---------- cuerpo en dos columnas ---------- */\n  #ccf .body { display:grid; grid-template-columns:minmax(280px, 340px) minmax(0, 1fr); gap:20px; align-items:start; }\n  @media (max-width: 980px) { #ccf .body { grid-template-columns:1fr; } #ccf .main { order:-1; } }\n\n  #ccf .side { background:var(--paper); border:1px solid var(--line); border-radius:10px; position:sticky; top:12px; max-height:calc(100vh - 24px); display:flex; flex-direction:column; }\n  @media (max-width: 980px) { #ccf .side { position:static; max-height:none; } }\n  #ccf .side-h { padding:14px 16px 10px; border-bottom:1px solid var(--line); }\n  #ccf .side-h h2 { font-size:15px; font-weight:600; margin:0; }\n  #ccf .side-h p { margin:3px 0 0; color:var(--ink3); font-size:12.5px; }\n  #ccf .side-b { overflow:auto; padding:4px 0 10px; }\n  #ccf .grp { padding:10px 16px 2px; color:var(--ink3); font-size:12.5px; font-weight:500; }\n  #ccf .prm { display:grid; grid-template-columns:1fr auto; gap:2px 10px; padding:7px 16px; cursor:pointer; border-left:3px solid transparent; }\n  #ccf .prm:hover { background:#F8FAFB; }\n  #ccf .prm.sel { background:var(--bluebg); border-left-color:var(--blue); }\n  #ccf .prm.ig { opacity:.45; }\n  #ccf .prm .nm { font-weight:500; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  #ccf .prm .cnt { font-weight:600; color:var(--dev); text-align:right; }\n  #ccf .prm .cnt.zero { color:var(--ok); font-weight:500; }\n  #ccf .prm .row2 { grid-column:1 / -1; display:flex; align-items:center; gap:8px; color:var(--ink2); font-size:12.5px; }\n  #ccf .prm .stdv { white-space:nowrap; }\n  #ccf .prm .track { flex:1; height:4px; background:var(--okbg); border-radius:2px; overflow:hidden; }\n  #ccf .prm .track > div { height:100%; background:var(--dev); }\n  #ccf .prm .edit { display:none; grid-column:1 / -1; gap:10px; align-items:center; padding-top:6px; }\n  #ccf .prm.sel .edit { display:flex; }\n  #ccf .prm select { height:28px; border:1px solid var(--line2); border-radius:5px; background:var(--paper); padding:0 6px; max-width:190px; }\n  #ccf .prm label { display:inline-flex; gap:5px; align-items:center; font-size:12.5px; color:var(--ink2); cursor:pointer; }\n  #ccf .side-f { border-top:1px solid var(--line); padding:10px 16px; font-size:12.5px; color:var(--ink3); display:flex; justify-content:space-between; gap:10px; }\n\n  /* ---------- lista de cámaras ---------- */\n  #ccf .main { min-width:0; }\n  #ccf .bar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:12px; }\n  #ccf .seg { display:inline-flex; background:var(--paper); border:1px solid var(--line2); border-radius:7px; padding:2px; }\n  #ccf .seg button { border:none; background:none; height:28px; padding:0 11px; border-radius:5px; cursor:pointer; color:var(--ink2); white-space:nowrap; }\n  #ccf .seg button b { font-weight:600; margin-left:4px; }\n  #ccf .seg button.on { background:var(--ink); color:#fff; }\n  #ccf .seg button.on b { color:#fff; }\n  #ccf .field { height:34px; border:1px solid var(--line2); border-radius:6px; background:var(--paper); padding:0 10px; }\n  #ccf input.field { flex:1 1 200px; min-width:160px; max-width:320px; }\n  #ccf .chip { display:inline-flex; align-items:center; gap:6px; background:var(--bluebg); color:#1B4C82; border-radius:6px; height:30px; padding:0 4px 0 10px; font-size:13px; }\n  #ccf .chip button { border:none; background:none; width:22px; height:22px; border-radius:4px; cursor:pointer; color:inherit; font-size:15px; line-height:1; }\n  #ccf .chip button:hover { background:#D5E3F5; }\n  #ccf .spacer { flex:1; }\n\n  #ccf .list { background:var(--paper); border:1px solid var(--line); border-radius:10px; overflow:hidden; }\n  #ccf .lh, #ccf .cam { display:grid; grid-template-columns:30px minmax(160px, 1.1fr) minmax(150px, .9fr) 118px minmax(240px, 2.3fr) 214px; gap:12px; align-items:start; padding:11px 16px; }\n  #ccf .lh { background:#F8FAFB; border-bottom:1px solid var(--line); color:var(--ink3); font-size:12.5px; font-weight:500; padding-top:9px; padding-bottom:9px; align-items:center; }\n  #ccf .lh [data-s] { cursor:pointer; user-select:none; }\n  #ccf .lh [data-s]:hover { color:var(--ink); }\n  #ccf .lh .sorted { color:var(--ink); }\n  #ccf .cam { border-bottom:1px solid var(--line); }\n  #ccf .cam:last-child { border-bottom:none; }\n  #ccf .cam.hasdev { box-shadow:inset 3px 0 0 var(--dev); }\n  #ccf .cam.flash { animation:ccfflash 1.2s ease-out; }\n  @keyframes ccfflash { from { background:#FFF4CC; } to { background:transparent; } }\n  @media (prefers-reduced-motion: reduce) { #ccf .cam.flash { animation:none; } #ccf .meter > div { transition:none; } }\n  #ccf .t1 { font-weight:500; }\n  #ccf .t1 a { color:var(--ink); text-decoration:none; }\n  #ccf .t1 a:hover { color:var(--blue); text-decoration:underline; }\n  #ccf .t2 { color:var(--ink3); font-size:12.5px; }\n  #ccf .conn { display:inline-flex; align-items:center; gap:6px; }\n  #ccf .dot { width:8px; height:8px; border-radius:50%; background:#A8B3BE; display:inline-block; }\n  #ccf .dot.online { background:var(--ok); } #ccf .dot.standby { background:#E0A526; }\n  #ccf .devs { display:flex; flex-wrap:wrap; gap:5px; }\n  #ccf .c-dev { min-width:0; }\n  #ccf .dv > span { white-space:nowrap; }\n  #ccf .dv { max-width:100%; flex-wrap:wrap; display:inline-flex; gap:0 6px; align-items:baseline; background:var(--devbg); border-radius:5px; padding:2px 8px; font-size:12.5px; }\n  #ccf .dv .k { color:var(--ink); }\n  #ccf .dv .v { color:var(--dev); font-weight:600; }\n  #ccf .dv .s { color:var(--ink3); }\n  #ccf .state { font-size:13px; font-weight:500; }\n  #ccf .state.ok { color:var(--ok); }\n  #ccf .state.na { color:var(--na); }\n  #ccf .state.load { color:var(--ink3); font-weight:400; }\n  #ccf .acts { display:flex; gap:6px; justify-content:flex-end; }\n  #ccf .empty { padding:28px 16px; color:var(--ink2); text-align:center; }\n\n  #ccf .detail { grid-column:2 / -1; margin-top:8px; padding:12px 14px; background:var(--surface); border-radius:8px; display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:14px 22px; }\n  #ccf .detail h4 { margin:0 0 4px; font-size:12.5px; font-weight:600; color:var(--ink2); }\n  #ccf .kv { display:flex; justify-content:space-between; gap:12px; padding:3px 0; font-size:13px; border-bottom:1px dashed var(--line); }\n  #ccf .kv:last-child { border-bottom:none; }\n  #ccf .kv .k { color:var(--ink2); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  #ccf .kv .v { white-space:nowrap; font-weight:500; }\n  #ccf .kv.d .v { color:var(--dev); }\n  #ccf .kv.d .k { color:var(--ink); }\n  #ccf .kv.ig { opacity:.5; }\n\n  @media (max-width: 760px) {\n    #ccf { padding:16px; }\n    #ccf .headline { font-size:24px; }\n    #ccf .mosaic { gap:2px; }\n    #ccf .tile { width:8px; height:8px; border-radius:1px; }\n    #ccf .seg { max-width:100%; overflow-x:auto; }\n    #ccf .cam > .acts { grid-column:2 / -1; justify-content:flex-start; }\n    #ccf .lh { display:none; }\n    #ccf .cam { grid-template-columns:28px 1fr auto; }\n    #ccf .cam > .c-cam, #ccf .cam > .c-conn { display:none; }\n    #ccf .cam > .c-dev { grid-column:2 / -1; }\n    #ccf .detail { grid-column:1 / -1; }\n  }\n\n  /* ---------- confirmación ---------- */\n  #ccf .modal-bg { position:fixed; inset:0; background:rgba(27,42,58,.4); display:none; align-items:center; justify-content:center; z-index:20; padding:16px; }\n  #ccf .modal { background:var(--paper); border-radius:12px; padding:22px 22px 18px; width:min(540px, 100%); max-height:calc(100vh - 32px); overflow:auto; box-shadow:0 18px 50px rgba(27,42,58,.25); }\n  #ccf .modal h3 { font-size:18px; font-weight:600; margin:0 0 8px; }\n  #ccf .modal p { margin:6px 0; color:var(--ink2); }\n  #ccf .modal ul { margin:10px 0; padding:0; list-style:none; max-height:260px; overflow:auto; border:1px solid var(--line); border-radius:8px; }\n  #ccf .modal li { padding:8px 12px; border-bottom:1px solid var(--line); font-size:13px; }\n  #ccf .modal li:last-child { border-bottom:none; }\n  #ccf .modal li b { font-weight:600; }\n  #ccf .modal .acts { margin-top:16px; }\n</style>\n</head>\n<body>\n<div id=\"ccf\">\n\n  <div class=\"head\">\n    <div class=\"head-text\">\n      <h1 class=\"headline\" id=\"ccf-headline\">Leyendo la configuración de las cámaras…</h1>\n      <p class=\"lede\" id=\"ccf-lede\">Cada cámara Surfsight se compara contra el estándar de la flota.</p>\n    </div>\n    <div class=\"head-actions\">\n      <button class=\"btn\" id=\"ccf-csv\">Exportar CSV</button>\n      <button class=\"btn primary\" id=\"ccf-reload\">Actualizar</button>\n    </div>\n  </div>\n\n  <div id=\"ccf-msg\" class=\"msg\"></div>\n\n  <section class=\"fleet\" aria-label=\"Estado de cada cámara\">\n    <div class=\"meter\" id=\"ccf-meter\"><div id=\"ccf-bar\"></div></div>\n    <div class=\"mosaic\" id=\"ccf-mosaic\"></div>\n    <div class=\"legend\">\n      <span><i style=\"background:var(--ok);opacity:.32\"></i>Conforme</span>\n      <span><i style=\"background:var(--dev1)\"></i>1 desvío</span>\n      <span><i style=\"background:var(--dev)\"></i>2 o más desvíos</span>\n      <span><i style=\"background:var(--na)\"></i>Sin lectura</span>\n    </div>\n  </section>\n\n  <div class=\"body\">\n    <aside class=\"side\" aria-label=\"Estándar de configuración\">\n      <div class=\"side-h\">\n        <h2>Estándar de la flota</h2>\n        <p id=\"ccf-stdnote\">El valor que tiene la mayoría de las cámaras. Elegí un parámetro para filtrar o cambiar su estándar.</p>\n      </div>\n      <div class=\"side-b\" id=\"ccf-params\"></div>\n      <div class=\"side-f\">\n        <span id=\"ccf-stdcount\"></span>\n        <button class=\"linkbtn\" id=\"ccf-stdreset\">Volver al valor de la mayoría</button>\n      </div>\n    </aside>\n\n    <main class=\"main\">\n      <div class=\"bar\">\n        <div class=\"seg\" id=\"ccf-seg\" role=\"tablist\">\n          <button data-f=\"dev\" class=\"on\">Con desvíos<b id=\"ccf-n-dev\">–</b></button>\n          <button data-f=\"all\">Todas<b id=\"ccf-n-all\">–</b></button>\n          <button data-f=\"ok\">Conformes<b id=\"ccf-n-ok\">–</b></button>\n          <button data-f=\"err\">Sin lectura<b id=\"ccf-n-err\">–</b></button>\n        </div>\n        <input type=\"search\" class=\"field\" id=\"ccf-q\" placeholder=\"Vehículo, patente o IMEI\">\n        <select class=\"field\" id=\"ccf-status\" aria-label=\"Conexión\">\n          <option value=\"\">Cualquier conexión</option>\n          <option value=\"online\">Online</option>\n          <option value=\"standby\">Standby</option>\n          <option value=\"offline\">Offline</option>\n        </select>\n        <span id=\"ccf-paramchip\"></span>\n      </div>\n\n      <div class=\"list\">\n        <div class=\"lh\">\n          <span><input type=\"checkbox\" id=\"ccf-all\" aria-label=\"Seleccionar las cámaras corregibles\"></span>\n          <span data-s=\"vehicle\">Vehículo</span>\n          <span data-s=\"imei\" class=\"c-cam\">Cámara</span>\n          <span data-s=\"status\" class=\"c-conn\">Conexión</span>\n          <span data-s=\"ndev\">Diferencias con el estándar</span>\n          <span class=\"acts\"><button class=\"btn sm fix\" id=\"ccf-bulk\" disabled>Aplicar estándar</button></span>\n        </div>\n        <div id=\"ccf-body\"><div class=\"empty\">Cargando cámaras…</div></div>\n      </div>\n    </main>\n  </div>\n\n  <div class=\"modal-bg\" id=\"ccf-modal\">\n    <div class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"ccf-m-title\">\n      <h3 id=\"ccf-m-title\"></h3>\n      <div id=\"ccf-m-body\"></div>\n      <div class=\"acts head-actions\" style=\"justify-content:flex-end\">\n        <button class=\"btn\" id=\"ccf-m-cancel\">Cancelar</button>\n        <button class=\"btn primary\" id=\"ccf-m-ok\">Aplicar estándar</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\ngeotab.addin.cameraConfig = function () {\n  \"use strict\";\n\n  var MS = \"https://media-services.geotab.com/api\";\n  var CONCURRENCY = 6;\n\n  // Nombres legibles y grupo de cada parámetro conocido de Surfsight. Los que no estén acá van a \"Otros\".\n  var LABELS = {\n    \"inCabinCameraRecording\": \"Grabación en cabina\",\n    \"driverCamera\": \"Cámara del conductor\",\n    \"liveVideo\": \"Video en vivo\",\n    \"notifyLiveStreaming\": \"Aviso de video en vivo\",\n    \"voiceRecording\": \"Grabación de voz\",\n    \"recordingEncryption.enabled\": \"Cifrado de grabaciones\",\n    \"textOverlay\": \"Texto sobre el video\",\n    \"distractedDriver\": \"Conductor distraído\",\n    \"adas\": \"ADAS\",\n    \"audioAlarms\": \"Alarmas sonoras\",\n    \"pinCodeDi\": \"Identificación por PIN\",\n    \"qrDi\": \"Identificación por QR\",\n    \"driverPin\": \"PIN del conductor\",\n    \"driverPosition\": \"Posición del conductor\",\n    \"brightness\": \"Brillo de pantalla\",\n    \"speedUnits\": \"Unidad de velocidad\",\n    \"dateTimeUnits\": \"Formato de fecha\",\n    \"privacy.gpsEnabled\": \"GPS\",\n    \"privacy.mvaiEnabled\": \"Eventos de IA\",\n    \"privacy.allEventsEnabled\": \"Todos los eventos\",\n    \"privacy.liveStreamEnabled\": \"Video en vivo\",\n    \"standby.timeout\": \"Espera antes de standby (s)\",\n    \"hotSpot.internetAccess\": \"Internet por hotspot\"\n  };\n  var GROUPS = [\n    [\"Video y grabación\", [\"inCabinCameraRecording\", \"driverCamera\", \"liveVideo\", \"notifyLiveStreaming\", \"voiceRecording\", \"recordingEncryption.enabled\", \"textOverlay\"]],\n    [\"Asistencia al conductor\", [\"distractedDriver\", \"adas\", \"audioAlarms\"]],\n    [\"Identificación del conductor\", [\"pinCodeDi\", \"qrDi\", \"driverPin\", \"driverPosition\"]],\n    [\"Pantalla y unidades\", [\"brightness\", \"speedUnits\", \"dateTimeUnits\"]],\n    [\"Privacidad\", [/^privacy\\./]],\n    [\"Sistema\", [\"standby.timeout\", \"hotSpot.internetAccess\"]]\n  ];\n  var VALUE_TEXT = { left: \"Izquierda\", right: \"Derecha\", kmh: \"km/h\", mph: \"mph\", eu: \"DD/MM/AAAA\", us: \"MM/DD/AAAA\" };\n\n  var api, headers = null, db = \"\", rows = [], loadToken = 0, loading = false;\n  var params = [];            // [{path, label, group, order, simple}]\n  var std = {};               // path -> valor estándar serializado (JSON)\n  var ignored = {};           // path -> true\n  var custom = false;\n  var filter = \"dev\", paramFilter = null, sortKey = \"ndev\", sortDir = -1, selected = {}, expanded = {};\n  var $ = function (id) { return document.getElementById(id); };\n\n  // ---------- sesión y llamadas ----------\n  function getHeaders() {\n    return new Promise(function (resolve, reject) {\n      // getSession(callback, newSession:boolean) — el 2.º parámetro es booleano\n      api.getSession(function (cred, server) {\n        if (!cred || !cred.sessionId) { reject(new Error(\"No se pudo obtener la sesión de MyGeotab. Volvé a iniciar sesión y actualizá.\")); return; }\n        db = cred.database;\n        resolve({\n          \"X-MyGeotab-Database\": cred.database,\n          \"X-MyGeotab-Username\": cred.userName,\n          \"X-MyGeotab-SessionId\": cred.sessionId,\n          \"X-MyGeotab-Path\": server || \"my.geotab.com\"\n        });\n      }, false);\n    });\n  }\n\n  function ms(path, opts) {\n    opts = opts || {};\n    var h = Object.assign({}, headers, opts.body ? { \"Content-Type\": \"application/json\" } : {});\n    return fetch(MS + path, { method: opts.method || \"GET\", headers: h, body: opts.body ? JSON.stringify(opts.body) : undefined })\n      .catch(function (e) {\n        var err = new Error(\"El navegador no pudo conectarse con el servicio de cámaras de Geotab (\" + e.message + \"). Revisá la conexión o si una política del navegador bloquea la llamada.\");\n        err.network = true; throw err;\n      });\n  }\n\n  function apiCall(method, p) { return new Promise(function (res, rej) { api.call(method, p, res, rej); }); }\n\n  // ---------- configuración: aplanado y comparación ----------\n  function flatten(obj, prefix, out, simple) {\n    Object.keys(obj || {}).forEach(function (k) {\n      var v = obj[k], p = prefix ? prefix + \".\" + k : k;\n      if (v && typeof v === \"object\" && !Array.isArray(v)) {\n        var keys = Object.keys(v);\n        if (keys.length === 1 && keys[0] === \"value\") { out[p] = v.value; if (!prefix) simple[p] = true; }\n        else flatten(v, p, out, simple);\n      } else if (Array.isArray(v)) {\n        v.forEach(function (item, i) {\n          if (item && typeof item === \"object\") {\n            var id = item.cameraId != null ? item.cameraId : i;\n            var sub = {}; Object.keys(item).forEach(function (kk) { if (kk !== \"cameraId\") sub[kk] = item[kk]; });\n            flatten(sub, p + \"[\" + id + \"]\", out, simple);\n          } else out[p + \"[\" + i + \"]\"] = item;\n        });\n      } else out[p] = v;\n    });\n    return out;\n  }\n\n  function labelOf(path) {\n    if (LABELS[path]) return LABELS[path];\n    var m = path.match(/^privacy\\.cameras\\[(\\d+)\\]\\.(\\w+)$/);\n    if (m) return \"Cámara \" + m[1] + \": \" + ({ recordingEnabled: \"grabación\", eventsEnabled: \"eventos\", liveStreamEnabled: \"video en vivo\" }[m[2]] || m[2]);\n    return path;\n  }\n  function groupOf(path) {\n    for (var g = 0; g < GROUPS.length; g++) {\n      var list = GROUPS[g][1];\n      for (var j = 0; j < list.length; j++) {\n        var it = list[j];\n        if (typeof it === \"string\" ? it === path : it.test(path)) return { name: GROUPS[g][0], order: g * 100 + (typeof it === \"string\" ? j : 50) };\n      }\n    }\n    return { name: \"Otros\", order: 900 };\n  }\n  var isSecret = function (path) { return /pin$/i.test(path); };\n  function fmt(path, v) {\n    if (v === undefined) return \"—\";\n    if (v === null) return \"Sin valor\";\n    if (v === true) return \"Sí\";\n    if (v === false) return \"No\";\n    if (isSecret(path)) return \"••••\";\n    return VALUE_TEXT[v] || String(v);\n  }\n  var ser = function (v) { return JSON.stringify(v === undefined ? null : v); };\n  var stdText = function 